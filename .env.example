# Copie este arquivo para .env e ajuste os valores:
#   Windows: copy .env.example .env   |   Linux/macOS: cp .env.example .env
# O arquivo .env é ignorado pelo git (contém segredos reais).

# URL do banco de dados (SQLite local, relativo à raiz do projeto)
DATABASE_URL=sqlite:///chatlocal.db

# Debug mode (controla o reload do uvicorn)
DEBUG=True

# Chave de assinatura dos JWTs (obrigatória em produção, NÃO versionar)
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=coloque-aqui-uma-chave-aleatoria

# Origens liberadas no CORS (frontends externos que consomem a API)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
